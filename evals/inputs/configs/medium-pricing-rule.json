{
  "codex": {
    "binary": "codex",
    "generator_extra_args": [
      "exec"
    ],
    "risk_extra_args": [
      "exec"
    ]
  },
  "claude": {
    "binary": "claude",
    "extra_args": [
      "-p",
      "--output-format",
      "json"
    ],
    "max_turns": 4
  },
  "context": {
    "enabled": false
  },
  "verification": [
    {
      "name": "pricing-rule",
      "argv": [
        "python",
        "-c",
        "from evals.fixture_app.pricing import discounted_price; assert discounted_price(100) == 90.0"
      ],
      "required": true,
      "timeout_seconds": 30
    }
  ],
  "budgets": {
    "max_fix_iterations": 1,
    "codex_max_calls": 4,
    "claude_max_calls": 3,
    "codex_timeout_seconds": 120,
    "claude_timeout_seconds": 120,
    "whole_run_timeout_seconds": 300
  },
  "diff_guard": {
    "max_files": 12,
    "max_lines": 800
  }
}
