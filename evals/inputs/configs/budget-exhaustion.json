{
  "codex": {
    "binary": "evals/tools/scripted_codex.py",
    "generator_extra_args": [
      "--scenario",
      "budget-exhaustion"
    ],
    "risk_extra_args": [
      "--scenario",
      "budget-exhaustion"
    ]
  },
  "claude": {
    "binary": "evals/tools/scripted_claude.py",
    "extra_args": [
      "--scenario",
      "budget-exhaustion"
    ],
    "max_turns": 2
  },
  "context": {
    "enabled": false
  },
  "verification": [],
  "budgets": {
    "max_fix_iterations": 1,
    "codex_max_calls": 0,
    "claude_max_calls": 3,
    "codex_timeout_seconds": 120,
    "claude_timeout_seconds": 120,
    "whole_run_timeout_seconds": 30
  },
  "diff_guard": {
    "max_files": 12,
    "max_lines": 800
  }
}
