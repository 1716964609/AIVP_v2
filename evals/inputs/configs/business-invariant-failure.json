{
  "codex": {
    "binary": "evals/tools/scripted_codex.py",
    "generator_extra_args": [
      "--scenario",
      "business-invariant"
    ],
    "risk_extra_args": [
      "--scenario",
      "business-invariant"
    ]
  },
  "claude": {
    "binary": "claude",
    "extra_args": [
      "-p",
      "--output-format",
      "json"
    ],
    "max_turns": 2
  },
  "context": {
    "enabled": false
  },
  "verification": [
    {
      "name": "narrow-refund-test",
      "argv": [
        "python",
        "-c",
        "from evals.fixture_app.business import can_refund; assert can_refund(True, 10) is True; assert can_refund(False, 10) is False"
      ],
      "required": true,
      "timeout_seconds": 30
    }
  ],
  "budgets": {
    "max_fix_iterations": 0,
    "codex_max_calls": 4,
    "claude_max_calls": 3,
    "codex_timeout_seconds": 120,
    "claude_timeout_seconds": 120,
    "whole_run_timeout_seconds": 300
  },
  "diff_guard": {
    "max_files": 12,
    "max_lines": 800
  }
}
