{
  "codex": {
    "binary": "evals/tools/scripted_codex.py",
    "generator_extra_args": [
      "--scenario",
      "controlled-repair"
    ],
    "risk_extra_args": [
      "--scenario",
      "controlled-repair"
    ]
  },
  "claude": {
    "binary": "evals/tools/scripted_claude.py",
    "extra_args": [
      "--scenario",
      "controlled-repair"
    ],
    "max_turns": 2
  },
  "context": {
    "enabled": false
  },
  "verification": [
    {
      "name": "repair-target",
      "argv": [
        "python",
        "-B",
        "-c",
        "from evals.fixture_app.repair_target import answer; assert answer() == 1"
      ],
      "required": true,
      "timeout_seconds": 30
    }
  ],
  "budgets": {
    "max_fix_iterations": 2,
    "codex_max_calls": 4,
    "claude_max_calls": 3,
    "codex_timeout_seconds": 120,
    "claude_timeout_seconds": 120,
    "whole_run_timeout_seconds": 300
  },
  "diff_guard": {
    "max_files": 12,
    "max_lines": 800
  }
}
